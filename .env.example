# บัญชี TCL Home
TCL_ACCOUNT=0812345678
TCL_PASSWORD=password!
TCL_COUNTRY_CODE=66

# Auth mode: ha (default, plain JSON แบบ Home Assistant) | ios_encrypted
TCL_AUTH_MODE=ha
TCL_HA_LOGIN_URL=https://pa.account.tcl.com/account/login?clientId=54148614
TCL_CLOUD_URLS_ENDPOINT=https://prod-center.aws.tcljd.com/v3/global/cloud_url_get
TCL_HA_APP_ID=wx6e1af3fa84fbe523

# โฮสต์บัญชี iOS encrypted (ใช้เมื่อ TCL_AUTH_MODE=ios_encrypted)
TCL_ACCOUNT_HOST=sg.account.tcl.com
TCL_CLIENT_ID=54148614

# iOS headers (ให้ตรงกับแอป)
TCL_PLATFORM=ios
TCL_APP_BUILD=1953
TCL_OS_TYPE=1
TCL_OS_VERSION=26.4.2
TCL_EQUIPMENT=2
TCL_DEVICE_MODEL=iPhone17,3

# ที่เก็บ session (token + refreshToken)
TCL_SESSION_FILE=~/.tcl-home/session.json

# IoT / แอร์
TCL_IOT_HOST=sgp-iot-api-prod.tcljd.com
TCL_IOT_APP_ID=f6hek6hdpt64jrw596
TCL_DEVICE_ID=DBbPYSvgAAE
TCL_IOT_COUNTRY_CODE=TH
TCL_IOT_TIMEZONE=Asia/Bangkok

# Burp MCP — ใช้กรอง history ตามเวลา (ลด noise)
# ตั้งก่อนให้ agent ดึง traffic หรือใช้กับ tcl_burp_cli.py
# เวลาใน Date header ของ Burp เป็น GMT — ค่า SINCE/UNTIL ใช้ GMT (UTC) เป็นค่าเริ่มต้น
TCL_BURP_TZ=UTC
TCL_BURP_DATE=2026-05-22
TCL_BURP_SINCE=08:30
TCL_BURP_UNTIL=08:35
